{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "heisei-reconcile-proof",
  "main": "src/reconcile-proof-worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "HEISEI_ENVIRONMENT": "reconcile-proof",
    "HEISEI_PROOF_DROP_AFTER_COMMIT": "true",
    "HEISEI_PROOF_RUNNER": "true",
    "HEISEI_QUOTA_CONFIG_SOURCE": "reconcile-proof-test-config",
    "HEISEI_QUOTA_SHORT_WINDOW_MS": "60000",
    "HEISEI_QUOTA_SHORT_REQUEST_LIMIT": "10",
    "HEISEI_QUOTA_LONG_WINDOW_MS": "86400000",
    "HEISEI_QUOTA_LONG_REQUEST_LIMIT": "100",
    "HEISEI_QUOTA_ADMISSION_WINDOW_MS": "86400000",
    "HEISEI_QUOTA_NEW_ADMISSION_LIMIT": "20",
    "HEISEI_QUOTA_MAX_ACTIVE_RESERVATIONS": "5",
    "HEISEI_QUOTA_RESERVATION_TTL_MS": "60000",
    "HEISEI_QUOTA_STATE_RETENTION_MS": "2592000000",
    "HEISEI_DATABASE_POOL_MAX": "2",
    "HEISEI_DATABASE_CONNECT_TIMEOUT_MS": "5000",
    "HEISEI_DATABASE_STATEMENT_TIMEOUT_MS": "10000",
    "HEISEI_DATABASE_QUERY_TIMEOUT_MS": "15000",
    "HEISEI_JWT_ISSUER": "https://heisei-reconcile-proof.satoworks.workers.dev",
    "HEISEI_JWT_AUDIENCE": "heisei-reconcile-proof",
    "HEISEI_JWT_JWKS_URI": "https://heisei-reconcile-proof.satoworks.workers.dev/__proof/jwks",
    "HEISEI_JWT_JWKS_JSON": "{\"keys\":[{\"kty\":\"RSA\",\"n\":\"u4wrAEtYWHZLk1Yl1w650zG8acjArZIPg3W_xSPcnOihA9VsHjnOeCIgqWINe62j8VKSkJGk5k1LT27uuHFgVkICHxVnDnnXPlcuGWNr7RjqQSBoQY9ye-ESZXWOZc6uPCKXj4Fi5h8xLb5QvJb-IqxFrliIbqb_Z3r1SOF0hU17CDH-BrZarcx12LKg7IKbZ3h3lQzPEAEt90oYl8pUbtFg1tItmnHuRjgs2LKYKrxY53A550s6tKP9fQ5F-D3aG-rUP071QqhXXatWGRp3kFUB4sX3BX00uMyNxFS5UmS7nQXLFQMKR3GFQFdmrkuSUC8rRpHXIABeOcQiLnxvMw\",\"e\":\"AQAB\",\"alg\":\"RS256\",\"use\":\"sig\",\"kid\":\"heisei-proof-e2e-v5\"}]}"
